#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# ---------------------------------------------------------------------------
# Scoped pre-push gate: route clippy/test to affected crates only.
# Falls back to full workspace on any routing error.
# ---------------------------------------------------------------------------

echo "[pre-push] determining scope..."
SCOPE=""
RUN_RUST="true"
RUN_GOVERNANCE="true"

if command -v python3 >/dev/null 2>&1 && [ -f scripts/ci_affected_crates.py ]; then
    ROUTING_OUTPUT=$(python3 scripts/ci_affected_crates.py --local --verbose 2>&1 || true)
    # Last line of stdout is the scope flags; stderr has diagnostics.
    SCOPE=$(echo "$ROUTING_OUTPUT" | grep -v '^\[ci-routing\]' | tail -1)

    if echo "$ROUTING_OUTPUT" | grep -q 'run_rust=False'; then
        RUN_RUST="false"
    fi
    if echo "$ROUTING_OUTPUT" | grep -q 'run_governance=False'; then
        RUN_GOVERNANCE="false"
    fi
else
    echo "[pre-push] WARNING: ci_affected_crates.py not found, running full workspace"
    SCOPE="--workspace"
fi

# ---------------------------------------------------------------------------
# Fast shared gate (python smoke + rust smoke + integrity)
# ---------------------------------------------------------------------------
echo "[pre-push] running shared check gate via ./makew..."
./makew check

# ---------------------------------------------------------------------------
# Rust quality gate -- scoped when possible, routed through nextest/make policy
# ---------------------------------------------------------------------------
if [ "$RUN_RUST" = "true" ]; then
    if [ -z "$SCOPE" ]; then
        # Empty scope with RUN_RUST=true means routing returned nothing useful.
        # This shouldn't happen, but be conservative.
        SCOPE="--workspace"
    fi
    echo "[pre-push] rust scope: $SCOPE"
    ./makew rust-regression-scoped RUST_SCOPE="$SCOPE"
    echo "[pre-push] OK: Rust quality gate passed."
else
    echo "[pre-push] SKIP: no Rust-relevant changes detected."
fi

# ---------------------------------------------------------------------------
# Governance gate (registry TOML checks)
# ---------------------------------------------------------------------------
if [ "$RUN_GOVERNANCE" = "true" ]; then
    echo "[pre-push] running governance gate..."
    ./makew governance-gate
else
    echo "[pre-push] SKIP: no governance-relevant changes detected."
fi

# ---------------------------------------------------------------------------
# ASCII + terminology gates (always run -- fast and universal)
# ---------------------------------------------------------------------------
./makew ascii-check
./makew terminology-gate

echo "[pre-push] OK: pre-push gate passed."

# Upload LFS objects before push (required when core.hooksPath overrides .git/hooks)
if command -v git-lfs >/dev/null 2>&1; then
    git lfs pre-push "$@"
fi
