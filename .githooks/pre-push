#!/usr/bin/env bash
# ============================================================================
# open_gororoba pre-push hook
#
# Runs the local validation workflow so no push lands without:
#   1. cache-check (fails on ballooned target dirs).
#   2. terminology-gate + ansi-check (repo hygiene).
#   3. rust-regression-scoped (warnings-as-errors, scoped tests).
#   4. validate-governance (registry integrity and schema signatures).
#
# Bypass escape hatch (documented in docs/toolchain/hooks.md if added):
#   git -c core.hooksPath=/dev/null push ...
# Use only when the gate itself is broken, not to dodge failures.
#
# Authored: 2026-04-17 (Phase 1 remediation; plan P1.S3.T2).
# ============================================================================

set -euo pipefail

# --- Capture stdin (refs to push) for deletion detection -------------------
# Git passes one line per pushed ref on stdin:
#   <local-ref> <local-sha> <remote-ref> <remote-sha>
refs_in="$(cat)"

# --- Skip gate for branch deletions ----------------------------------------
# For `git push --delete <branch>`, local-sha is all-zeros. There is no
# new code to gate; skip the gate so deletions are instant.
zero_sha="0000000000000000000000000000000000000000"
all_zero=true
nonempty=false
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${local_ref:-}" ] && continue
    nonempty=true
    if [ "${local_sha:-}" != "$zero_sha" ]; then
        all_zero=false
        break
    fi
done <<< "$refs_in"
if $nonempty && $all_zero; then
    echo '[pre-push] branch deletion detected (all-zero local SHA); skipping gate.'
    exit 0
fi

# --- Gate chain --------------------------------------------------------------
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# The local validation entrypoint performs one scoped workflow:
#
#   - cache-check
#   - workspace routing + scoped clippy/test (warnings-as-errors)
#   - validate-governance (which includes terminology-gate and
#     ansi-check via the markdown/TOML invariant gate)
echo '[pre-push] running make validate-local'
make validate-local

echo '[pre-push] OK: validation passed, push allowed.'
