# ==============================================================================
# Open Gororoba: Standardized Git Exclusion Policy
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global / OS / Editor Noise
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
.claude/
.gemini/
.playwright-mcp/
.horusec/
*.pdf

# ------------------------------------------------------------------------------
# 2. Languages & Build Systems
# ------------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
*.egg-info/
src/*.egg-info/
venv/
.venv/
.venv_ingest/
.mamba/

# Rust
target/
target_codex_hve/
target_codex_hve2/
.cache/
.cache/cargo-default-target/
.cache/cargo-home/
.cache/gate-target/
.cache/profiles/
.cache/tensor_avt_eval/
.cache/tensor_avt_profile/
rustc-ice-*.txt

# Coq / Rocq
curated/01_theory_frameworks/*.vo
curated/01_theory_frameworks/*.vos
curated/01_theory_frameworks/*.vok
curated/01_theory_frameworks/*.glob
proofs/**/*.vo
proofs/**/*.vos
proofs/**/*.vok
proofs/**/*.glob
proofs/**/*.aux
proofs/Makefile.coq
proofs/Makefile.coq.conf
proofs/.Makefile.coq.d
*.lia.cache
*.nra.cache

# ------------------------------------------------------------------------------
# 3. Project Artifact Infrastructure (Standardized)
# ------------------------------------------------------------------------------

# Dedicated artifact & log directories
build/
dist/
dist_py/
logs/
reports/benchmark_*.txt
reports/*.csv
reports/*.txt
reports/*.json

# LaTeX build outputs
docs/latex/out/

# Temporary / Scratch space
temp/
tmp/
*.tmp
*.temp
temp.*

# ------------------------------------------------------------------------------
# 4. Data & External Resources (Managed via Makefile)
# ------------------------------------------------------------------------------

