data/h5/
data/artifacts/images/
data/artifacts/*.mp4
data/artifacts/*.png
data/artifacts/c756_frames/
data/artifacts/*.json
data/artifacts/*.txt
!data/artifacts/PROVENANCE.local.json
data/artifacts/frames_*/
data/e027/
data/test-e027/
data/csv/
