ttps://relx-elsevier-erms.file.force.com/servlet/servlet.ImageServer?id=015Tl00000DCExQIAX&oid=00D1t000000qIy5EAE&lastMod=1729268846475\\\",\\\"firstName\\\":\\\"Gwyn\\\",\\\"fieldsOfInterest\\\":\\\"Rational Cherednik algebras,&nbsp;algebraic Lie theory,&nbsp;differential operators,&nbsp;  17B,&nbsp;16S,&nbsp;20G05,&nbsp;13N10,&nbsp;32C28,&nbsp;Representation Theory\\\",\\\"ecn\\\":202725,\\\"accreditation\\\":\\\"PhD\\\"},{\\\"type\\\":\\\"Member\\\",\\\"organisationCountry\\\":\\\"United Kingdom\\\",\\\"organisationCity\\\":\\\"Bristol\\\",\\\"organisation\\\":\\\"University of Bristol\\\",\\\"lastName\\\":\\\"Burness\\\",\\\"firstName\\\":\\\"Tim\\\",\\\"fieldsOfInterest\\\":\\\"Finite groups, Simple groups, Permutation groups, Algebraic groups\\\",\\\"ecn\\\":553537,\\\"accreditation\\\":\\\"PhD\\\"},{\\\"type\\\":\\\"Member\\\",\\\"organisationCountry\\\":\\\"United Kingdom\\\",\\\"organisationCity\\\":\\\"Coventry\\\",\\\"organisation\\\":\\\"University of Warwick\\\",\\\"lastName\\\":\\\"Capdeboscq\\\",\\\"firstName\\\":\\\"Inna\\\",\\\"fieldsOfInterest\\\":\\\"Group Theory, Kac-Moody groups 20B, 20D, 20G44\\\",\\\"ecn\\\":145670},{\\\"type\\\":\\\"Member\\\",\\\"organisationCountry\\\":\\\"France\\\",\\\"organisationCity\\\":\\\"Paris\\\",\\\"organisation\\\":\\\"CNRS & Sorbonne Université\\\",\\\"lastName\\\":\\\"Chardin\\\",\\\"firstName\\\":\\\"Marc\\\",\\\"fieldsOfInterest\\\":\\\" Commutative Algebra, 13\\\",\\\"ecn\\\":672219,\\\"accreditation\\\":\\\"PhD\\\"},{\\\"type\\\":\\\"Member\\\",\\\"organisationCountry\\\":\\\"China\\\",\\\"organisationCity\\\":\\\"Shanghai\\\",\\\"organisation\\\":\\\"Fudan University\\\",\\\"lastName\\\":\\\"Chen\\\",\\\"firstName\\\":\\\"Miaofen\\\",\\\"fieldsOfInterest\\\":\\\"Number theory,&nbsp;Arithmetic Geometry,&nbsp;11G18,&nbsp;14G22,&nbsp;14G35,&nbsp;14L05\\\",\\\"ecn\\\":649165,\\\"accreditation\\\":\\\"PhD\\\"},{\\\"type\\\":\\\"Member\\\",\\\"organisationRegion\\\":\\\"Missouri\\\",\\\"organisationCountry\\\":\\\"United States\\\",\\\"organisationCity\\\":\\\"Columbia\\\",\\\"organisation\\\":\\\"University of Missouri\\\",\\\"lastName\\\":\\\"Cutkosky\\\",\\\"firstName\\\":\\\"Steven Dale\\\",\\\"fieldsOfInterest\\\":\\\"Algebraic geometry, commutative algebra, 14, 13\\\",\\\"ecn\\\":65946},{\\\"type\\\":\\\"Member\\\",\\\"organisationCountry\\\":\\\"Belgium\\\",\\\"organisationCity\\\":\\\"Gent\\\",\\\"organisation\\\":\\\"Ghent University\\\",\\\"lastName\\\":\\\"De Medts\\\",\\\"firstName\\\":\\\"Tom\\\",\\\"fieldsOfInterest\\\":\\\"Nonassociative algebras,&nbsp;Exceptional groups,&nbsp;Geometric group theory,&nbsp;Buildings. MSC codes-17,&nbsp;20E,&nbsp;20F29,&nbsp;20F65,&nbsp;20G15,&nbsp;20G41,&nbsp;51E24\\\",\\\"ecn\\\":678018,\\\"accreditation\\\":\\\"PhD\\\"},{\\\"type\\\":\\\"Member\\\",\\\"organisationCountry\\\":\\\"Austria\\\",\\\"organisationCity\\\":\\\"Graz\\\",\\\"organisation\\\":\\\"University of Graz\\\",\\\"lastName\\\":\\\"Faber\\\",\\\"firstName\\\":\\\"Eleonore\\\",\\\"fieldsOfInterest\\\":\\\"commutative algebra, representation theory, algebraic geometry, cluster categories, cluster algebras, homological algebra,&nbsp;13C14, 13F60, 14E16, 14A22, 14B05, 16G,\\\",\\\"ecn\\\":649565,\\\"accreditation\\\":\\\"PhD\\\"},{\\\"type\\\":\\\"Member\\\",\\\"organisationCountry\\\":\\\"France\\\",\\\"organisationCity\\\":\\\"Paris\\\",\\\"organisation\\\":\\\"Paris Cité University\\\",\\\"lastName\\\":\\\"Hernandez\\\",\\\"firstName\\\":\\\"David\\\",\\\"fieldsOfInterest\\\":\\\"Lie algebras,&nbsp;quantum groups,&nbsp;representations of algebras,&nbsp;cluster algebras,&nbsp;categorification,&nbsp;  2010 MSC,&nbsp; 20G,&nbsp;16G,&nbsp;17B,&nbsp;81R,&nbsp;22E\\\",\\\"ecn\\\":202726,\\\"accreditation\\\":\\\"PhD\\\"},{\\\"type\\\":\\\"Member\\\",\\\"organisationCountry\\\":\\\"Spain\\\",\\\"organisationCity\\\":\\\"Madrid\\\",\\\"organisation\\\":\\\"Autonomous University of Madrid, Department of Mathematics\\\",\\\"lastName\\\":\\\"Jaikin-Zapirain\\\",\\\"firstName\\\":\\\"Andrei\\\",\\\"fieldsOfInterest\\\":\\\"Group Theory,&nbsp;Ring Theory,&nbsp;20E,&nbsp;20F,&nbsp;16S,&nbsp;20D\\\",\\\"ecn\\\":523409,\\\"accreditation\\\":\\\"PhD\\\"},{\\\"type\\\":\\\"Member\\\",\\\"organisationCountry\\\":\\\"United Kingdom\\\",\\\"organisationCity\\\":\\\"Lincoln\\\",\\\"organisation\\\":\\\"University of Lincoln\\\",\\\"lastName\\\":\\\"Khukhro\\\",\\\"firstName\\\":\\\"Evgeny\\\",\\\"fieldsOfInterest\\\":\\\"Group Theory,&nbsp;20\\\",\\\"ecn\\\":65951,\\\"accreditation\\\":\\\"DSc\\\"},{\\\"type\\\":\\\"Member\\\",\\\"organisationCountry\\\":\\\"Poland\\\",\\\"organisationCity\\\":\\\"Szczecin\\\",\\\"organisation\\\":\\\"University of Szczecin Institute of Mathematics\\\",\\\"lastName\\\":\\\"Kuhlmann\\\",\\\"firstName\\\":\\\"Franz-Viktor\\\",\\\"fieldsOfInterest\\\":\\\"Valuation theory, real algebra, ordered structures, model theoretic algebra. 12J,&nbsp;  12L12,&nbsp;  03C60, 03C64,&nbsp;  06A05, 06A06,&nbsp;  06F15, 06F20\\\",\\\"ecn\\\":523410},{\\\"type\\\":\\\"Member\\\",\\\"organisationCountry\\\":\\\"United Kingdom\\\",\\\"organisationCity\\\":\\\"London\\\",\\\"organisation\\\":\\\"City St George's University of London\\\",\\\"lastName\\\":\\\"Linckelmann\\\",\\\"firstName\\\":\\\"Markus\\\",\\\"fieldsOfInterest\\\":\\\"Representation theory of finite groups\\\",\\\"ecn\\\":170378},{\\\"type\\\":\\\"Member\\\",\\\"organisationCountry\\\":\\\"Spain\\\",\\\"organisationCity\\\":\\\"Zaragoza\\\",\\\"organisation\\\":\\\"University of Zaragoza\\\",\\\"lastName\\\":\\\"Martínez Pérez\\\",\\\"firstName\\\":\\\"Conchita\\\",\\\"fieldsOfInterest\\\":\\\"Group theory\\\",\\\"ecn\\\":680370,\\\"biography\\\":\\\"My main research field is geometric and combinatorial group theory, including group cohomological finiteness conditions, Artin groups, right angled Artin groups and their automorphisms and interactions between group theory and algebraic structures such as Lie algebras or path algebras. I defended my PhD thesis in Zaragoza in 2000 and then I was a postdoc at the ETH in Zürich. Later I became associated professor in the Department of Mathematics of the University of Zaragoza. and since 2022 I hold a Professorship in the same Department.I have been PI (Principal Investigator) of several Research Grants of the Spanish Ministry of Education since 2016 and also of the Spanish Network in Group Theory. I am author of around 50 publications and have participated as invited speaker in more than 20 international workshops or conferences.Since 2015 I have had several administrative positions in the University of Zaragoza: Coordinator of the Maths degree, profesora secretaria, chair of the quality committee of the maths degree and deputy director of the research institute in mathematics (IUMA).\\\",\\\"accreditation\\\":\\\"PhD\\\"},{\\\"type\\\":\\\"Member\\\",\\\"organisationCountry\\\":\\\"Sweden\\\",\\\"organisationCity\\\":\\\"Uppsala\\\",\\\"organisation\\\":\\\"Uppsala University\\\",\\\"lastName\\\":\\\"Mazorchuk\\\",\\\"firstName\\\":\\\"Volodymyr\\\",\\\"fieldsOfInterest\\\":\\\"Lie algebras,&nbsp;Lie superalgebras,&nbsp;homological methods,&nbsp;categorification,&nbsp;semigroups,&nbsp;17B,&nbsp;16E,&nbsp;18D05\\\",\\\"ecn\\\":99182,\\\"accreditation\\\":\\\"PhD\\\"},{\\\"type\\\":\\\"Member\\\",\\\"organisationCountry\\\":\\\"France\\\",\\\"organisationCity\\\":\\\"Reims\\\",\\\"organisation\\\":\\\"University of Reims Champagne-Ardenne\\\",\\\"lastName\\\":\\\"Morier-Genoud\\\",\\\"firstName\\\":\\\"Sophie\\\",\\\"fieldsOfInterest\\\":\\\"Combinatorics,&nbsp;Representation theory,&nbsp;Number theoryMSC 05A30,&nbsp;05E10,&nbsp;13F60,&nbsp;14M15,&nbsp;11A55,&nbsp;11B65.\\\",\\\"ecn\\\":687080,\\\"accreditation\\\":\\\"PhD\\\"},{\\\"type\\\":\\\"Member\\\",\\\"organisationCountry\\\":\\\"Argentina\\\",\\\"organisationCity\\\":\\\"Córdoba\\\",\\\"organisation\\\":\\\"National University of Cordoba\\\",\\\"lastName\\\":\\\"Natale\\\",\\\"firstName\\\":\\\"Sonia\\\",\\\"fieldsOfInterest\\\":\\\"Hopf algebras,&nbsp;Monoidal and tensor categories,&nbsp;Quantum groups\\\",\\\"ecn\\\":581733,\\\"accreditation\\\":\\\"PhD\\\"},{\\\"type\\\":\\\"Member\\\",\\\"organisationRegion\\\":\\\"Indiana\\\",\\\"organisationCountry\\\":\\\"United States\\\",\\\"organisationCity\\\":\\\"Notre Dame\\\",\\\"organisation\\\":\\\"University of Notre Dame\\\",\\\"lastName\\\":\\\"Polini\\\",\\\"image\\\":\\\"https://relx-elsevier-erms.file.force.com/servlet/servlet.ImageServer?id=015Tl00000E6x5QIAR&oid=00D1t000000qIy5EAE&lastMod=1731094794509\\\",\\\"firstName\\\":\\\"Claudia\\\",\\\"fieldsOfInterest\\\":\\\"Commutative Algebra 13\\\",\\\"ecn\\\":536138,\\\"accreditation\\\":\\\"PhD\\\"},{\\\"type\\\":\\\"Member\\\",\\\"organisationCountry\\\":\\\"France\\\",\\\"organisationCity\\\":\\\"Villetaneuse\\\",\\\"organisation\\\":\\\"Sorbonne North Paris University\\\",\\\"lastName\\\":\\\"Quéguiner-Mathieu\\\",\\\"firstName\\\":\\\"Anne\\\",\\\"fieldsOfInterest\\\":\\\"Quadratic and Hermitian forms,&nbsp;Algebras with involution,&nbsp;Linear algebraic groups over arbitrary fields,&nbsp;Chow motives,&nbsp;sections of MSC 11E04,&nbsp;11E39,&nbsp;11E72,&nbsp;11E81,&nbsp;11E88,&nbsp;14C15,&nbsp;16W10,&nbsp;20G15.\\\",\\\"ecn\\\":633729,\\\"accreditation\\\":\\\"PhD, HdR\\\"},{\\\"type\\\":\\\"Member\\\",\\\"organisationCountry\\\":\\\"Israel\\\",\\\"organisationCity\\\":\\\"Ramat Gan\\\",\\\"organisation\\\":\\\"Bar-Ilan University\\\",\\\"lastName\\\":\\\"Rowen\\\",\\\"firstName\\\":\\\"Louis\\\",\\\"fieldsOfInterest\\\":\\\"Noncommutative algebra,&nbsp; division algebras, structure of rings, 16B, 16K, 16N, 16P, 16S, 16U, 16W, 16\\\",\\\"ecn\\\":98528},{\\\"type\\\":\\\"Member\\\",\\\"organisationRegion\\\":\\\"Maharashtra\\\",\\\"organisationCountry\\\":\\\"India\\\",\\\"organisationCity\\\":\\\"Mumbai\\\",\\\"organisation\\\":\\\"Tata Institute of Fundamental Research\\\",\\\"lastName\\\":\\\"Srinivas\\\",\\\"firstName\\\":\\\"Vasudevan\\\",\\\"fieldsOfInterest\\\":\\\"Algebraic K-Theory,&nbsp;  Homological Algebra,&nbsp;  Characteristic P Methods,&nbsp;  14C,&nbsp;  14B,&nbsp;  14F,&nbsp;  13D,&nbsp;  13H,&nbsp;  13C\\\",\\\"ecn\\\":86760},{\\\"type\\\":\\\"Member\\\",\\\"organisationRegion\\\":\\\"Indiana\\\",\\\"organisationCountry\\\":\\\"United States\\\",\\\"organisationCity\\\":\\\"West Lafayette\\\",\\\"organisation\\\":\\\"Purdue University\\\",\\\"lastName\\\":\\\"Ulrich\\\",\\\"firstName\\\":\\\"Bernd\\\",\\\"fieldsOfInterest\\\":\\\"Commutative Algebra,&nbsp;  MSC2000 13\\\",\\\"ecn\\\":87921},{\\\"type\\\":\\\"Member\\\",\\\"organisationCountry\\\":\\\"China\\\",\\\"organisationCity\\\":\\\"Beijing\\\",\\\"organisation\\\":\\\"Capital Normal University\\\",\\\"lastName\\\":\\\"Xi\\\",\\\"firstName\\\":\\\"Changchang\\\",\\\"fieldsOfInterest\\\":\\\"16Gxx Representations of algebras,&nbsp;  18Gxx Homological algebra,&nbsp;  Hecke algebras, Cellular algebras\\\",\\\"ecn\\\":72721},{\\\"type\\\":\\\"Member\\\",\\\"organisationCountry\\\":\\\"China\\\",\\\"organisationCity\\\":\\\"Xiamen\\\",\\\"organisation\\\":\\\"Xiamen University School of Mathematical Sciences\\\",\\\"lastName\\\":\\\"Yu\\\",\\\"firstName\\\":\\\"Nina\\\",\\\"fieldsOfInterest\\\":\\\"Lie algebras and Lie superalgebras, sections of MSC 17B69 and 17B65\\\",\\\"ecn\\\":670703,\\\"accreditation\\\":\\\"PhD\\\"}]},{\\\"heading\\\":\\\"Managing Editor of the Section on Computational Algebra\\\",\\\"entries\\\":[{\\\"type\\\":\\\"Member\\\",\\\"organisationCountry\\\":\\\"New Zealand\\\",\\\"organisationCity\\\":\\\"Auckland Central\\\",\\\"organisation\\\":\\\"The University of Auckland, Department of Mathematics\\\",\\\"lastName\\\":\\\"O'Brien\\\",\\\"firstName\\\":\\\"Eamonn\\\",\\\"fieldsOfInterest\\\":\\\"Group theory,&nbsp;representation theory,&nbsp;computation,&nbsp;algorithms 20D15,&nbsp;20C20,&nbsp;20C40,&nbsp;20-04\\\",\\\"ecn\\\":65976,\\\"accreditation\\\":\\\"PhD\\\"}]},{\\\"heading\\\":\\\"Section on Computational Algebra\\\",\\\"entries\\\":[{\\\"type\\\":\\\"Member\\\",\\\"organisationCountry\\\":\\\"United States\\\",\\\"organisationCity\\\":\\\"University Park\\\",\\\"organisation\\\":\\\"The Pennsylvania State University\\\",\\\"lastName\\\":\\\"Eisenträger\\\",\\\"firstName\\\":\\\"Kirsten\\\",\\\"fieldsOfInterest\\\":\\\"Number theory,&nbsp;arithmetic geometry 11Y,&nbsp;11G,&nbsp;11U\\\",\\\"ecn\\\":211809,\\\"accreditation\\\":\\\"PhD\\\"},{\\\"type\\\":\\\"Member\\\",\\\"organisationCountry\\\":\\\"Italy\\\",\\\"organisationCity\\\":\\\"Trento\\\",\\\"organisation\\\":\\\"University of Trento\\\",\\\"lastName\\\":\\\"de Graaf\\\",\\\"firstName\\\":\\\"Willem A.\\\",\\\"fieldsOfInterest\\\":\\\"Lie theory,&nbsp;Computational Algebra&lt;br&gt;17B, 20G05, 20G15, 22E46, 22E47\\\",\\\"ecn\\\":223807,\\\"accreditation\\\":\\\"PhD\\\"},{\\\"type\\\":\\\"Member\\\",\\\"organisationRegion\\\":\\\"Nebraska\\\",\\\"organisationCountry\\\":\\\"United States\\\",\\\"organisationCity\\\":\\\"Lincoln\\\",\\\"organisation\\\":\\\"University of Nebraska-Lincoln\\\",\\\"lastName\\\":\\\"Hermiller\\\",\\\"firstName\\\":\\\"Susan\\\",\\\"fieldsOfInterest\\\":\\\"Geometric, algorithmic, and combinatorial aspects of infinite group theory,&nbsp; 20F, 57M05, 68Q42, 68Q45 or 20F05, 20F06, 20F10, 20F65, 20F67, 20F69, 57M05, 68Q42, 68Q45\\\",\\\"ecn\\\":506068},{\\\"type\\\":\\\"Member\\\",\\\"organisationCountry\\\":\\\"Germany\\\",\\\"organisationCity\\\":\\\"Tübingen\\\",\\\"organisation\\\":\\\"University of Tübingen\\\",\\\"lastName\\\":\\\"Markwig\\\",\\\"firstName\\\":\\\"Hannah\\\",\\\"fieldsOfInterest\\\":\\\"Tropical geometry, algebraic geometry, discrete geometry 14T, 52, 14N10, 14N35, 14M25, 14M15, 14P99.\\\",\\\"ecn\\\":506067},{\\\"type\\\":\\\"Member\\\",\\\"organisationCountry\\\":\\\"United Kingdom\\\",\\\"organisationCity\\\":\\\"St Andrews\\\",\\\"organisation\\\":\\\"University of St Andrews\\\",\\\"lastName\\\":\\\"Roney-Dougal\\\",\\\"firstName\\\":\\\"Colva\\\",\\\"fieldsOfInterest\\\":\\\"Permutation groups 20B,&nbsp;05E15,&nbsp;05E16 Abstract finite groups and maximal subgroups 20D,&nbsp;20E28 Computational group theory 20-08,&nbsp;68Q Probabilistic and asymptotic group properties 20F69,&nbsp;20P\\\",\\\"ecn\\\":649166,\\\"accreditation\\\":\\\"PhD\\\"},{\\\"type\\\":\\\"Member\\\",\\\"organisationCountry\\\":\\\"France\\\",\\\"organisationCity\\\":\\\"Paris\\\",\\\"organisation\\\":\\\"Sorbonne University\\\",\\\"lastName\\\":\\\"Safey El Din\\\",\\\"firstName\\\":\\\"Mohab\\\",\\\"fieldsOfInterest\\\":\\\"Symbolic computation and algebraic computation 68W30,&nbsp;Computational aspects and applications of commutative rings 13Pxx,&nbsp;Computational real algebraic geometry 14Q30,&nbsp;Effectivity,&nbsp;complexity and computational aspects of algebraic geometry 14Q20,&nbsp;Software related to these aspects\\\",\\\"ecn\\\":93117,\\\"accreditation\\\":\\\"Habilitation thesis, PhD\\\"},{\\\"type\\\":\\\"Member\\\",\\\"organisationCountry\\\":\\\"France\\\",\\\"organisationCity\\\":\\\"Villers-lès-Nancy\\\",\\\"organisation\\\":\\\"Inria Research Centre Nancy Grand Est\\\",\\\"lastName\\\":\\\"Thomé\\\",\\\"firstName\\\":\\\"Emmanuel\\\",\\\"fieldsOfInterest\\\":\\\"Computational Number Theory 11Y,&nbsp;Cryptography 94A60 11T71 14G50,&nbsp;Computer algebra 68W30,&nbsp;Finite fields 11T06,&nbsp;Software related to these aspects 11-04 14-04 68-04 94-04\\\",\\\"ecn\\\":559628,\\\"accreditation\\\":\\\"PhD\\\"},{\\\"type\\\":\\\"Member\\\",\\\"organisationRegion\\\":\\\"Colorado\\\",\\\"organisationCountry\\\":\\\"United States\\\",\\\"organisationCity\\\":\\\"Fort Collins\\\",\\\"organisation\\\":\\\"Colorado State University\\\",\\\"lastName\\\":\\\"Wilson\\\",\\\"firstName\\\":\\\"James B.\\\",\\\"fieldsOfInterest\\\":\\\"Nilpotent groups and algebras 16N40, 20D15,&nbsp;Jordan, Lie,&nbsp;universal algebra and their categories &amp;,&nbsp;,&nbsp;  modules 17A, 68W,&nbsp;Isomorphism Problems,&nbsp;Complexity &amp;,&nbsp;,&nbsp;  Foundations related to algebraic computation 68Q, 03F65\\\",\\\"ecn\\\":645772}]},{\\\"heading\\\":\\\"Founding Editor\\\",\\\"entries\\\":[{\\\"type\\\":\\\"Member\\\",\\\"lastName\\\":\\\"Higman\\\",\\\"firstName\\\":\\\"Graham\\\",\\\"fieldsOfInterest\\\":\\\"1964-1984\\\",\\\"ecn\\\":80375}]},{\\\"heading\\\":\\\"Former Editors-in-Chief\\\",\\\"entries\\\":[{\\\"type\\\":\\\"Member\\\",\\\"lastName\\\":\\\"Broué, 2001-2017\\\",\\\"firstName\\\":\\\"Michel\\\",\\\"ecn\\\":65941},{\\\"type\\\":\\\"Member\\\",\\\"lastName\\\":\\\"Feit, 1985–2000\\\",\\\"firstName\\\":\\\"Walter\\\",\\\"ecn\\\":35984}]}]\",\"isOpenAccessOptionsV2\":true,\"isGuideForAuthorsV2\":true,\"genderIndicatorsV2\":{\"Percentage_Nonbinary_or_Gender_diverse_123\":\"0%\",\"Percentage_Man_123\":\"50%\",\"Percentage_editors_level_1_2_and_3_reported\":\"65%\",\"Total_overall_editors_level_1_2_and_3\":\"40\",\"Percentage_prefer_not_to_disclose_123\":\"8%\",\"Percentage_Woman_123\":\"42%\"},\"apcListPrice\":[{\"price\":3510,\"currencyCode\":\"USD\"}],\"contentTypeCode\":\"JL\",\"hasAboutPage\":true,\"hasAimsAndScope\":true,\"journalMetrics\":{\"bannerMetrics\":{\"impactFactor\":{\"value\":\"0.8\",\"year\":2024},\"citeScore\":{\"value\":\"1.6\",\"year\":2024,\"url\":\"https://www.scopus.com/sourceid/23814\"}},\"journalInsights\":[{\"metricKey\":\"time_to_1st_decision\",\"label\":\"Submission to first decision\",\"value\":7.082604,\"order\":0,\"unit\":\"day\",\"centralTendencyFunction\":\"median\"},{\"metricKey\":\"review_time\",\"label\":\"Submission to decision after review\",\"value\":108.636643519,\"order\":1,\"unit\":\"day\",\"centralTendencyFunction\":\"median\"},{\"metricKey\":\"acceptance_speed\",\"label\":\"Submission to acceptance\",\"value\":238.500735,\"order\":2,\"unit\":\"day\",\"centralTendencyFunction\":\"median\"},{\"metricKey\":\"publication_time\",\"label\":\"Acceptance to online publication\",\"value\":4.98552,\"order\":3,\"unit\":\"day\",\"centralTendencyFunction\":\"median\"}]},\"editorialBoard\":{\"groups\":[]}},\"marketingContent\":{\"isFetching\":false,\"elements\":{\"news\":{\"label\":\"News\",\"items\":[{\"published\":true,\"url\":\"publish-your-best-research-with-journal-of-algebra\",\"LAST_PROCESSED\":\"2026-02-08T22:04:15.800387648\",\"contentId\":172195,\"publishDate\":\"2016-05-27T00:00:00Z\",\"intro\":\"&lt;p&gt;\\r\\n\\tThe &lt;em&gt;Journal of Algebra&lt;/em&gt; is a leading international journal publishing high quality research results in algebra and related computational aspects.&lt;/p&gt;\",\"lastModifiedDate\":\"2021-03-20T02:05:47.053Z\",\"description\":\"&lt;p&gt;\\r\\n\\tThe &lt;em&gt;Journal of Algebra&lt;/em&gt; is a leading international journal publishing high quality research results in algebra and related computational aspects. Only the best and most interesting papers are considered for publication in the journal. This journal offers many unique benefits including:&lt;/p&gt;\\r\\n&lt;ul&gt;\\r\\n\\t&lt;li&gt;\\r\\n\\t\\tAn &lt;a href=\\\"http://www.journals.elsevier.com/journal-of-algebra/open-archive\\\"&gt;open archive&lt;/a&gt;; all articles published after 48 months have &lt;strong&gt;unrestricted access&lt;/strong&gt; and will remain &lt;strong&gt;permanently free&lt;/strong&gt; to read and download.&lt;/li&gt;\\r\\n\\t&lt;li&gt;\\r\\n\\t\\tA customized &lt;a href=\\\"https://www.elsevier.com/authors/journal-authors/share-link\\\" target=\\\"_blank\\\"&gt;&lt;strong&gt;Share Link&lt;/strong&gt;&lt;/a&gt;&lt;strong&gt;;&lt;/strong&gt; giving you 50 days unlimited free access to share your paper with all your networks.&lt;/li&gt;\\r\\n\\t&lt;li&gt;\\r\\n\\t\\tAn expert and dedicated &lt;a href=\\\"http://www.journals.elsevier.com/journal-of-algebra/editorial-board\\\"&gt;editorial board&lt;/a&gt;; treating your research with the care and attention it deserves.&lt;/li&gt;\\r\\n\\t&lt;li&gt;\\r\\n\\t\\tA global readership; nearly &lt;strong&gt;1.5 million&lt;/strong&gt; full-text articles were downloaded in the last five years.&lt;/li&gt;\\r\\n\\t&lt;li&gt;\\r\\n\\t\\tContent innovations; &nbsp;&lt;a href=\\\"https://www.elsevier.com/books-and-journals/content-innovation/audioslides\\\" target=\\\"_blank\\\"&gt;AudioSlides&lt;/a&gt; lets you convey your mathematical ideas in your own words and &lt;a href=\\\"https://www.elsevier.com/books-and-journals/content-innovation/iplots\\\" target=\\\"_blank\\\"&gt;Interactive Plots&lt;/a&gt; lets readers explore your data and other quantitative results that are otherwise buried in plots.&lt;/li&gt;\\r\\n&lt;/ul&gt;\\r\\n&lt;p&gt;\\r\\n\\tPublish your best research with &lt;em&gt;Journal of Algebra&lt;/em&gt; and get the best results!&lt;/p&gt;\",\"type\":\"news\",\"title\":\"Publish your best research with Journal of Algebra\",\"displayDate\":\"27 May 2016\"}]},\"announcements\":{\"label\":\"Announcements\",\"items\":[{\"published\":true,\"url\":\"pledges-to-improve-diversity-journal-of-algebra\",\"LAST_PROCESSED\":\"2026-02-08T22:16:42.67226516\",\"contentId\":252178,\"publishDate\":\"2022-12-13T12:00:00Z\",\"intro\":\"&lt;p&gt;Pledges to improve diversity&lt;/p&gt;\",\"lastModifiedDate\":\"2022-12-14T03:52:30.263Z\",\"description\":\"&lt;p&gt;This journal pledges to improve diversity on the editorial team. In the next two years we will be increasing various representations in our journal to ensure the involved scientific community is fully represented. This sits within Elsevier’s broader ongoing &lt;a rel=\\\"noopener\\\" href=\\\"https://www.elsevier.com/inclusion-and-diversity\\\" target=\\\"_blank\\\"&gt;inclusion and diversity&lt;/a&gt; efforts. Equity and inclusion in publishing is critically important for scientific excellence and innovation. We believe passionately in the power of an inclusive publishing environment.&lt;/p&gt;\",\"type\":\"announcements\",\"title\":\"Pledges to improve diversity - Journal of Algebra\",\"displayDate\":\"13 December 2022\"}]}}},\"trackLoadTime\":{},\"rssModal\":{\"isOpen\":false},\"recommendedJournals\":{},\"participatingJournalsMetadata\":{},\"callForPaperContent\":{},\"onixCode\":{},\"isVolumeEntitled\":{},\"serverRenderError\":null}"</script></div>
