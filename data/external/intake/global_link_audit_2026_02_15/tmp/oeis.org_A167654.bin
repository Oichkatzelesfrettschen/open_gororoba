                <div class=seqnum>
                    
                        A167654
                    
                </div>
                <div class=seqname>
                    Simple zero-divisors of Cayley-Dickson algebras.
                    
                </div>
            </div>
            <div class=scorerefs>
                        
                        0
            </div>
        </div>
        
            
    
    
    <div>
