            <li class="c-article-subject-list__subject"><a href="/subjects/particle-physics" data-track="click" data-track-action="view subject" data-track-label="link">Particle physics</a></li><li class="c-article-subject-list__subject"><a href="/subjects/phenomenology" data-track="click" data-track-action="view subject" data-track-label="link">Phenomenology</a></li><li class="c-article-subject-list__subject"><a href="/subjects/physics" data-track="click" data-track-action="view subject" data-track-label="link">Physics</a></li><li class="c-article-subject-list__subject"><a href="/subjects/theoretical-particle-physics" data-track="click" data-track-action="view subject" data-track-label="link">Theoretical particle physics</a></li>
