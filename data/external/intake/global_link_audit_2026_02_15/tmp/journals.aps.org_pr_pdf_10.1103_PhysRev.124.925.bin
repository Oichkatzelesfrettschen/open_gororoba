          <path title="user icon" d="M12.3333 13C12.3333 12.0696 12.3333 11.6044 12.2185 11.2259C11.9599 10.3736 11.293 9.70669 10.4407 9.44816C10.0622 9.33333 9.597 9.33333 8.66662 9.33333H5.3333C4.40292 9.33333 3.93773 9.33333 3.5592 9.44816C2.70693 9.70669 2.03999 10.3736 1.78145 11.2259C1.66663 11.6044 1.66663 12.0696 1.66663 13M9.99996 4C9.99996 5.65685 8.65681 7 6.99996 7C5.3431 7 3.99996 5.65685 3.99996 4C3.99996 2.34315 5.3431 1 6.99996 1C8.65681 1 9.99996 2.34315 9.99996 4Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg><span>Sign in</span></button></div></div><a class="nav-link mb-2 mt-4" href="/all_journals">All Journals</a><a class="nav-link" href="https://physics.aps.org/">Physics Magazine</a></div></div></div><div class="sub-header"></div></header><script>function handleHamburgerButton(obj) {
  if (obj){
    // Toggle the state when clicked on
    const open_state = obj.getAttribute('data-is-open') === "false";
    obj.setAttribute('data-is-open', open_state)

    // Display/hide the hamburger menu items
    // Change the hamburger icon
    const menu_items = document.querySelector('#hamburger-menu-contents')
    const open_icon = document.querySelector('#openedHamburgerIcon')
    const closed_icon = document.querySelector('#closedHamburgerIcon')
    if (open_icon && closed_icon){
      if (open_state){
        closed_icon.classList.add('hidden')
        open_icon.classList.remove('hidden')
        menu_items.style='display:grid';
      }
      else {
        closed_icon.classList.remove('hidden')
        open_icon.classList.add('hidden')
        menu_items.style='display:none';
      }
    }
  }
}

// Handle account dropdown clicks for Safari compatibility
// The CSS :focus-within approach doesn't work reliably in Safari
document.addEventListener('DOMContentLoaded', function() {
  // Ensure parent containers have position relative for absolute positioning
  const dropdownContainers = document.querySelectorAll('.account-info-dropdown');
  dropdownContainers.forEach(function(container) {
    const computedStyle = window.getComputedStyle(container);
    if (computedStyle.position === 'static') {
      container.style.position = 'relative';
    }
  });

  const signedinButtons = document.querySelectorAll('button.signedin');

  signedinButtons.forEach(function(button) {
    button.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();

      // Find the parent dropdown container
      const dropdownContainer = this.closest('.account-info-dropdown');
      if (!dropdownContainer) return;

      // Find the dropdown menu
      const dropdown = dropdownContainer.querySelector('.dropdown');
      if (!dropdown) return;

      // Toggle the dropdown visibility using inline styles to override CSS
      const isCurrentlyVisible = !dropdown.classList.contains('hidden') ;

      if (isCurrentlyVisible) {
        // Hide the dropdown
        dropdown.style.display = 'none';
        dropdown.classList.add('hidden');
        dropdown.classList.remove('grid');
      } else {
        // Show the dropdown
        dropdown.classList.remove('hidden');
        dropdown.classList.add('grid');
        dropdown.style.display = 'grid';
        dropdown.style.visibility = 'visible';
      }
    });
  });

  // Close dropdown when clicking outside
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.account-info-dropdown')) {
      const dropdowns = document.querySelectorAll('.account-info-dropdown .dropdown');
      dropdowns.forEach(function(dropdown) {
        dropdown.style.display = 'none';
        dropdown.classList.add('hidden');
        dropdown.classList.remove('grid');
      });
    }
  });
});</script><main class="w-full" data-testid="main_container" id="main"><div class="generic-main-container"><div class="site-container"><div class="site" id="full-unauthorized-page"><div id="auth-required"><div id="unauthorized-content-wrapper"><h1 class="text-text-regular-neutral heading-lg-bold">Authorization Required</h1><div class="px-6 py-2 bg-brand-primary-50 rounded-200 border border-brand-primary-200 justify-start items-center gap-2 w-full flex"><div class="w-5 justify-center items-center flex"><svg fill="none" height="20" viewBox="0 0 21 20" width="21" xmlns="http://www.w3.org/2000/svg"><g id="alert-circle"><path d="M10.4998 6.66675V10.0001M10.4998 13.3334H10.5082M18.8332 10.0001C18.8332 14.6025 15.1022 18.3334 10.4998 18.3334C5.89746 18.3334 2.1665 14.6025 2.1665 10.0001C2.1665 5.39771 5.89746 1.66675 10.4998 1.66675C15.1022 1.66675 18.8332 5.39771 18.8332 10.0001Z" id="Icon" stroke="#00538B" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.66667"></path></g></svg></div><div class="text-text-regular-primary t-sm-regular">We need you to provide your credentials before accessing this content.</div></div><div class="p-6 bg-surface-neutral rounded-200 border border-border-neutral-subtle flex flex-col gap-6"><div class="login-option-block"><div class="flex-col gap-1 pb-4 sm-desktop:pb-0 text-text-regular-neutral"><h2 class="heading-sm-bold">Log in via your institution</h2><div class="t-sm-regular">If your institution provides access using Shibboleth/OpenAthens log in.</div></div><div class="shrink-0"><a class="button md-primary-button font text-[13px]" href="/auth/openathens/login?rt=https%3A%2F%2Fjournals.aps.org%2Fpr%2Fpdf%2F10.1103%2FPhysRev.124.925" rel="nofollow" style="width: 100%;">OpenAthens Log In<svg fill="none" height="20" viewBox="0 0 21 20" width="21" xmlns="http://www.w3.org/2000/svg"><g id="link-external-01"><path d="M18 7.5L18 2.5M18 2.5H13M18 2.5L11.3333 9.16667M8.83333 4.16667H7C5.59987 4.16667 4.8998 4.16667 4.36502 4.43915C3.89462 4.67883 3.51217 5.06129 3.27248 5.53169C3 6.06647 3 6.76654 3 8.16667V13.5C3 14.9001 3 15.6002 3.27248 16.135C3.51217 16.6054 3.89462 16.9878 4.36502 17.2275C4.8998 17.5 5.59987 17.5 7 17.5H12.3333C13.7335 17.5 14.4335 17.5 14.9683 17.2275C15.4387 16.9878 15.8212 16.6054 16.0608 16.135C16.3333 15.6002 16.3333 14.9001 16.3333 13.5V11.6667" id="Icon" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.66667"></path></g></svg></a></div></div><div class="login-option-block"><div class="justify-end items-center gap-4 sm-desktop:gap-8 grid sm-desktop:flex"><div class="flex flex-col gap-1 text-text-regular-neutral"><h2 class="heading-sm-bold">Log in via APS Member Subscription</h2><div class="t-sm-regular">If you have a personal subscription through your APS membership please log in.</div><div class="t-sm-regular italic">Starting August 1, 2019 APS member subscribers will need to log in using your member credentials instead of your APS Journal Account.</div></div><div class="shrink-0"><a class="button md-primary-button text-[13px] tablet:text-lg" href="/auth/apsmember/login?rt=https%3A%2F%2Fjournals.aps.org%2Fpr%2Fpdf%2F10.1103%2FPhysRev.124.925" rel="nofollow" style="width: 100%;">APS Member Log In<svg fill="none" height="20" viewBox="0 0 21 20" width="21" xmlns="http://www.w3.org/2000/svg"><g id="link-external-01"><path d="M18 7.5L18 2.5M18 2.5H13M18 2.5L11.3333 9.16667M8.83333 4.16667H7C5.59987 4.16667 4.8998 4.16667 4.36502 4.43915C3.89462 4.67883 3.51217 5.06129 3.27248 5.53169C3 6.06647 3 6.76654 3 8.16667V13.5C3 14.9001 3 15.6002 3.27248 16.135C3.51217 16.6054 3.89462 16.9878 4.36502 17.2275C4.8998 17.5 5.59987 17.5 7 17.5H12.3333C13.7335 17.5 14.4335 17.5 14.9683 17.2275C15.4387 16.9878 15.8212 16.6054 16.0608 16.135C16.3333 15.6002 16.3333 14.9001 16.3333 13.5V11.6667" id="Icon" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.66667"></path></g></svg></a></div></div></div><div class="flex flex-col"><h2 cla