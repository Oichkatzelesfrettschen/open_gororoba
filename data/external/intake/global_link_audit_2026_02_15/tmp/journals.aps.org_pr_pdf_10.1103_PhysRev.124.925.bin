</div><div class="utility full-width-footer-header content-container"><div class="global w-full justify-between items-center gap-8 flex"><div class="flex gap-8 items-center"><a class="logo-link" href="https://www.aps.org/"><img alt="APS logo" class="w-20" src="//cdn.journals.aps.org/development/journals/images/tailwind/footer-logo.png" /></a><a class="nav-link" href="https://www.aps.org/news">News</a><a class="nav-link" href="https://www.aps.org/membership/join">Join APS</a></div><a class="logo-link" href="https://www.purposeledpublishing.org/"><img alt="Purpose Led Publishing - Science is our shareholder" class="h-[56px]" src="//cdn.journals.aps.org/development/journals/images/tailwind/plp-logo.png" /></a></div></div><script>document.addEventListener('DOMContentLoaded', function() {
  /* Setup event listeners for accordians */
  const collapsable_menus = document.querySelectorAll('.accordion-collapse-heading')
  collapsable_menus.forEach(collapsable_menu =>{
      const button_el = collapsable_menu.querySelector('button')
      if (button_el){
        button_el.addEventListener('click',toggleAccordion)
      }
    })

  /* Setup listeners for toggling the Show/Hide Abstract button states */
  const abstract_buttons = document.querySelectorAll('button.abstract-toggle')
  abstract_buttons.forEach(abstract_button =>{
      if (abstract_button){
        abstract_button.addEventListener('click',toggleShowAbstractButton)
      }
    })
}, false);

function toggleShowAbstractButton() {
  const current_title_el = this.querySelector('span')
  if (! current_title_el) return 

  const current_title = current_title_el.textContent
  const is_closed = (current_title === 'Show Abstract')
  if (is_closed) {
    current_title_el.textContent = "Hide Abstract";

    let icon_el = this.querySelector('.chevron-down')
    if (icon_el){
      icon_el.classList.add("hidden")
    }
    icon_el = this.querySelector('.chevron-up')
    if (icon_el){
      icon_el.classList.remove("hidden")
    }
  }
  else {
    console.log("is open")
    current_title_el.textContent = "Show Abstract";

    let icon_el = this.querySelector('.chevron-up')
    if (icon_el){
      icon_el.classList.add("hidden")
    }
    icon_el = this.querySelector('.chevron-down')
    if (icon_el){
      icon_el.classList.remove("hidden")
    }

  }
}


function toggleAccordion() {
  const content = this.closest('.accordion-collapse-heading').nextElementSibling;
  const opened_icon = this.querySelector('.opened-icon')
  const closed_icon = this.querySelector('.closed-icon')

  // Toggle the content's max-height for smooth opening and closing
  // Toggle the accordian icon
  if (content.style.maxHeight && content.style.maxHeight !== '0px') {
    content.style.maxHeight = '0';
    content.style.display = 'none'
    this.setAttribute('aria-expanded', "false")
    if (opened_icon) {
      opened_icon.classList.add('hidden')
      closed_icon.classList.remove('hidden')
    }
  } else {
    content.style.maxHeight = '100%';
    content.style.display = 'block'
    this.setAttribute('aria-expanded', "true")
    if (opened_icon) {
      opened_icon.classList.remove('hidden')
      closed_icon.classList.add('hidden')
    }
  }
}</script><div class="w-full bg-surface-neutral"><div class="footer-links py-12 flex justify-between bg-surface-neutral items-start content-container"><div class="FooterLinksColumn w-48 flex-col justify-start items-start gap-6 inline-flex"><div class="ListHeadline text-text-regular-neutral text-base font-bold leading-normal">Authors</div><ul class="List flex-col justify-start items-start gap-3 flex"><li><a class='default-link' href=/authors>General Information</a></li><li><a class='default-link' href=https://authors.aps.org/Submissions/>Submit a Manuscript</a></li><li><a class='default-link' href=/pub_rights.html>Publication Rights</a></li><li><a class='default-link' href=/open-science>Open Science</a></li><li><a class='default-link' href=/authors/tips-authors-physical-review-physical-review-letters>Tips for Authors</a></li><li><a class='default-link' href=/authors/professional-conduct-ethics>Professional Conduct</a></li></ul></div><div class="FooterLinksColumn w-48 flex-col justify-start items-start gap-6 inline-flex"><div class="ListHeadline text-text-regular-neutral text-base font-bold leading-normal">Reviewers</div><ul class="List flex-col justify-start items-start gap-3 flex"><li><a class='default-link' href=/referees>General Information</a></li><li><a class='default-link' href=http://referees.aps.org/>Submit a Report</a></li><li><a class='default-link' href=http://referees.aps.org/>Update Your Information</a></li><li><a class='default-link' href=/referees/faq.html>Reviewer FAQ</a></li><li><a class='default-link' href=/OutstandingReferees>Outstanding Referees</a></li></ul></div><div class="FooterLinksColumn w-48 flex-col justify-start items-start gap-6 inline-flex"><div class="ListHeadline text-text-regular-neutral text-base font-bold leading-normal">Librarians</div><ul class="List flex-col justify-start items-start gap-3 flex"><li><a class='default-link' href=https://librarians.aps.org/>General Information</a></li><li><a class='default-link' href=https://libra