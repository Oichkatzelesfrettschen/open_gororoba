<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/RWD-Table-Patterns@6.1.3/dist/css/rwd-table.min.css"
      integrity="sha256-+Tvx/K+1gRdQKKEbjo2cTH740apU/fDuLI3QmNTdIKY="
      crossorigin="anonymous"
>
<script>
  $(document).ready(function () {
    $("#events-per-page-sel").on("change", function () {
      const url_params = new URLSearchParams(window.location.search);
      url_params.delete("page");
      url_params.delete("pagesize");
      pagesize = $("#events-per-page-sel").val();
      if (pagesize == "all") {
        url_params.append("pagesize", "all");
      } else {
        url_params.append("page", 1);
        url_params.append("pagesize", pagesize);
      }
      window.location.href = location.pathname + "?" + url_params;
    });

    // Initialize RWD-Table options
    $(function() {
      $('.table-responsive').responsiveTable({
        pattern: "priority-columns",
        sortable: true,
        // We use a special comparison function to properly handle columns of floating point values.
        // See issue #655.
        // `a` and `b` are arrays [value of the row (as string), index]
        // so we usually only use the first element.
        // `dir` is the direction of sorting
        compareFunction: function(a, b, dir) {
          // Try to compare as floats
          // We don't convert `a[0]` and `b[0]` to floats otherwise string comparison doesn't work
          // Missing values are represented as "--" so parseFloat return NaN
          // Therefore, they are handled as strings
          a0 = isNaN(parseFloat(a[0])) ? a[0] : parseFloat(a[0])
          b0 = isNaN(parseFloat(b[0])) ? b[0] : parseFloat(b[0])
          if (typeof(a0) === "number" && typeof(b0) === "number") {
            return a0 < b0 ? -dir : dir;
          }
          // Compare as strings (this is similar to the default sort function)
          return a[0].localeCompare(b[0], undefined, {numeric: true}) < 0 ? -dir : dir
        },
      });
    });
  });
</script>
