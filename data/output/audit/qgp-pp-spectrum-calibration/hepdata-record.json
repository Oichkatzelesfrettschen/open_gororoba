e 8/yoda.h5","yoda1":"https://www.hepdata.net/download/table/ins1657384/Table 8/yoda1"},"description":"Additional systematic error for PBPB 0-5 pct data: +2.7 pct -2.7 pct Additional systematic error for PBPB 5-10 pct data:...","doi":"10.17182/hepdata.86210.v1/t8","id":358376,"location":"Data from Figure 6","messages":false,"name":"Table 8","processed_name":"Table8","resources":[]},{"data":{"csv":"https://www.hepdata.net/download/table/ins1657384/Table 9/csv","json":"https://www.hepdata.net/download/table/ins1657384/Table 9/json","root":"https://www.hepdata.net/download/table/ins1657384/Table 9/root","yaml":"https://www.hepdata.net/download/table/ins1657384/Table 9/yaml","yoda":"https://www.hepdata.net/download/table/ins1657384/Table 9/yoda","yoda.h5":"https://www.hepdata.net/download/table/ins1657384/Table 9/yoda.h5","yoda1":"https://www.hepdata.net/download/table/ins1657384/Table 9/yoda1"},"description":"Additional systematic error for P-PB NSD data: +4.6 pct -4.6 pct.","doi":"10.17182/hepdata.86210.v1/t9","id":358377,"location":"Data from Figure 7","messages":false,"name":"Table 9","processed_name":"Table9","resources":[]}],"mode":"record","overall_status":"finished","participant_count":2,"recid":86210,"record":{"abstract":"We report the measured transverse momentum ($p_{\\rm T}$) spectra of primary charged particles from pp, p-Pb and Pb-Pb collisions at a center-of-mass energy $\\sqrt{s_{\\rm NN}} = 5.02$ TeV in the kinematic range of $0.15<p_{\\rm T}<50$ GeV/$c$ and $|\\eta|< 0.8$. A significant improvement of systematic uncertainties motivated the reanalysis of data in pp and Pb-Pb collisions at $\\sqrt{s_{\\rm NN}} = 2.76$ TeV, as well as in p-Pb collisions at $\\sqrt{s_{\\rm NN}} = 5.02$ TeV, which is also presented. Spectra from Pb-Pb collisions are presented in nine centrality intervals and are compared to a reference spectrum from pp collisions scaled by the number of binary nucleon-nucleon collisions. For central collisions, the $p_{\\rm T}$ spectra are suppressed by more than a factor of 7 around 6-7 GeV/$c$ with a significant reduction in suppression towards higher momenta up to 30 GeV/$c$. The nuclear modification factor $R_{\\rm pPb}$, constructed from the pp and p-Pb spectra measured at the same collision energy, is consistent with unity above 8 GeV/$c$. While the spectra in both pp and Pb-Pb collisions are substantially harder at $\\sqrt{s_{\\rm NN}} = 5.02$ TeV compared to 2.76 TeV, the nuclear modification factors show no significant collision energy dependence. The obtained results should provide further constraints on the parton energy loss calculations to determine the transport properties of the hot and dense QCD matter.","access_urls":{"links":{"csv":"https://www.hepdata.net/download/submission/ins1657384/1/csv","json":"https://www.hepdata.net/download/submission/ins1657384/1/json","root":"https://www.hepdata.net/download/submission/ins1657384/1/root","yaml":"https://www.hepdata.net/download/submission/ins1657384/1/yaml","yoda":"https://www.hepdata.net/download/submission/ins1657384/1/yoda","yoda-h5":"https://www.hepdata.net/download/submission/ins1657384/1/yoda.h5"}},"analyses":[],"arxiv_id":"arXiv:1802.09145","collaborations":["ALICE"],"control_number":"86210","creation_date":"2018-02-25","data_abstract":"","data_keywords":{"cmenergies":[{"gte":2760.0,"lte":2760.0},{"gte":5020.0,"lte":5020.0},{"gte":2760.0,"lte":5020.0}],"observables":["RPPB","RAA","DATA/MC","SPECTRA RATIOS","D2N/DETARAP/DPT"],"reactions":["PB PB --> CHARGED X","P P --> CHARGED X : PB PB --> CHARGED X","P PB --> CHARGED X","P P --> CHARGED X"]},"doc_type":"publication","doi":"10.1007/JHEP11(2018)013","first_author":{"affiliation":"","full_name":"Acharya, S."},"hepdata_doi":"10.17182/hepdata.86210.v1","id":86210,"inspire_id":"1657384","journal_info":"JHEP 11 (2018) 013","keywords":[{"source":"author","value":"Heavy Ion Experiments"},{"source":"author","value":"Heavy-ion collision"},{"schema":"INSPIRE","value":"heavy ion: scattering"},