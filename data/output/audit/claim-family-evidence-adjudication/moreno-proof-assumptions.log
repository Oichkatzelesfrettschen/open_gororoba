AuditedSkew.im_rx_eq_im_lx :
  forall x y : SedMoreno.A,
  SedMoreno.conj x = SedMoreno.neg x ->
  (forall z : SedMoreno.A,
   SedMoreno.inner y (SedMoreno.mul z x) = Rdefinitions.IZR BinNums.Z0) ->
  forall z : SedMoreno.A,
  SedMoreno.inner y (SedMoreno.mul x z) = Rdefinitions.IZR BinNums.Z0
AuditedSkew.im_lx_eq_im_rx :
  forall x y : SedMoreno.A,
  SedMoreno.conj x = SedMoreno.neg x ->
  (forall z : SedMoreno.A,
   SedMoreno.inner y (SedMoreno.mul x z) = Rdefinitions.IZR BinNums.Z0) ->
  forall z : SedMoreno.A,
  SedMoreno.inner y (SedMoreno.mul z x) = Rdefinitions.IZR BinNums.Z0
FunctionalExtensionality.functional_extensionality_dep :
