","messages":false,"name":"Table 15","processed_name":"Table15","resources":[]},{"data":{"csv":"https://www.hepdata.net/download/table/ins1377750/Table 16/csv","json":"https://www.hepdata.net/download/table/ins1377750/Table 16/json","root":"https://www.hepdata.net/download/table/ins1377750/Table 16/root","yaml":"https://www.hepdata.net/download/table/ins1377750/Table 16/yaml","yoda":"https://www.hepdata.net/download/table/ins1377750/Table 16/yoda","yoda.h5":"https://www.hepdata.net/download/table/ins1377750/Table 16/yoda.h5","yoda1":"https://www.hepdata.net/download/table/ins1377750/Table 16/yoda1"},"description":"Proton-to-pion ratio integrated for pT &gt; 10 GeV/c measured in Pb-Pb collisions.","doi":"10.17182/hepdata.71310.v1/t16","id":63257,"location":"Data from Figure 27 (right)","messages":false,"name":"Table 16","processed_name":"Table16","resources":[]}],"mode":"record","overall_status":"finished","participant_count":0,"recid":71310,"record":{"abstract":"Transverse momentum ($p_{\\rm{T}}$) spectra of pions, kaons, and protons up to $p_{\\rm{T}} = 20$ GeV/$c$ have been measured in Pb-Pb collisions at $\\sqrt{s_{\\rm NN}} = 2.76$ TeV using the ALICE detector for six different centrality classes covering 0-80%. The proton-to-pion and the kaon-to-pion ratios both show a distinct peak at $p_{\\rm{T}} \\approx 3$ GeV/$c$ in central Pb-Pb collisions that decreases towards more peripheral collisions. For $p_{\\rm{T}} > 10$ GeV/$c$, the nuclear modification factor is found to be the same for all three particle species in each centrality interval within systematic uncertainties of 10-20%. This suggests there is no direct interplay between the energy loss in the medium and the particle species composition in the hard core of the quenched jet. For $p_{\\rm{T}} < 10$ GeV/$c$, the data provide important constraints for models aimed at describing the transition from soft to hard physics.","access_urls":{"links":{"csv":"https://www.hepdata.net/download/submission/ins1377750/1/csv","json":"https://www.hepdata.net/download/submission/ins1377750/1/json","root":"https://www.hepdata.net/download/submission/ins1377750/1/root","yaml":"https://www.hepdata.net/download/submission/ins1377750/1/yaml","yoda":"https://www.hepdata.net/download/submission/ins1377750/1/yoda"}},"analyses":[],"arxiv_id":"arXiv:1506.07287","collaborations":["ALICE"],"control_number":"71310","creation_date":"2015-06-24","data_abstract":"CERN-LHC.  Transverse momentum ($p_{\\rm{T}}$) spectra of pions, kaons, and protons up to $p_{\\rm{T}} = 20$ GeV/$c$ have been measured in Pb-Pb collisions at $\\sqrt{s_{\\rm NN}} = 2.76$ TeV using the ALICE detector for six different centrality classes covering 0-80%. The proton-to-pion and the kaon-to-pion ratios both show a distinct peak at $p_{\\rm{T}} \\approx 3$ GeV/$c$ in central Pb-Pb collisions that decreases towards more peripheral collisions. For $p_{\\rm{T}} &gt; 10$ GeV/$c$, the nuclear modification factor is found to be the same for all three particle species in each centrality interval within systematic uncertainties of 10-20%.","data_keywords":{"cmenergies":[{"gte":2.76,"lte":2.76}],"observables":["DN/DPT","RATIO"],"phrases":["Inclusive","Strange production","Proton-Proton Scattering","Single Differential Distribution","Transverse Momentum Dependence"],"reactions":["P P --> PBAR X","P P --> K+ X","PB PB --> K- X","PB PB --> PBAR X","PB PB --> PI+ X","PB PB --> K+ X","PB PB --> P X","PB PB --> PI- X","P P --> K- X","P P --> PI- X","P P --> P X","P P --> PI+ X"]},"doc_type":"publication","doi":"10.1103/PhysRevC.93.034913","first_author":{"affiliation":"Prague, Tech. U.","full_name":"Adam, Jaroslav"},"hepdata_doi":"10.17182/hepdata.71310.v1","id":71310,"inspire_id":1377750,"journal_info":"Phys.Rev.C 93 (2016) 034913","keywords":[{"schema":"INSPIRE","value":"charged particle"},{"schema":"INSPIRE","value":"K"},{"schema":"INSPIRE","value":"p"},{"schema":"INSPIRE","value":"jet: quenching"},{"schema":"INSPIRE","value":"pi: spectru