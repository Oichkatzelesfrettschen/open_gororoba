ww.hepdata.net/download/table/ins1672944/Table 43/root","yaml":"https://www.hepdata.net/download/table/ins1672944/Table 43/yaml","yoda":"https://www.hepdata.net/download/table/ins1672944/Table 43/yoda","yoda.h5":"https://www.hepdata.net/download/table/ins1672944/Table 43/yoda.h5","yoda1":"https://www.hepdata.net/download/table/ins1672944/Table 43/yoda1"},"description":"Average R_{+1} for 8 &lt; pT &lt; 20 GeV/c versus centrality percentile","doi":"10.17182/hepdata.89396.v1/t43","id":413685,"location":"Figure 6","messages":false,"name":"Table 43","processed_name":"Table43","resources":[]},{"data":{"csv":"https://www.hepdata.net/download/table/ins1672944/Table 44/csv","json":"https://www.hepdata.net/download/table/ins1672944/Table 44/json","root":"https://www.hepdata.net/download/table/ins1672944/Table 44/root","yaml":"https://www.hepdata.net/download/table/ins1672944/Table 44/yaml","yoda":"https://www.hepdata.net/download/table/ins1672944/Table 44/yoda","yoda.h5":"https://www.hepdata.net/download/table/ins1672944/Table 44/yoda.h5","yoda1":"https://www.hepdata.net/download/table/ins1672944/Table 44/yoda1"},"description":"Slope of a linear fit to R_{+1} for 8 &lt; pT &lt; 20 GeV/c versus centrality percentile","doi":"10.17182/hepdata.89396.v1/t44","id":413686,"location":"Figure 7","messages":false,"name":"Table 44","processed_name":"Table44","resources":[]},{"data":{"csv":"https://www.hepdata.net/download/table/ins1672944/Table 45/csv","json":"https://www.hepdata.net/download/table/ins1672944/Table 45/json","root":"https://www.hepdata.net/download/table/ins1672944/Table 45/root","yaml":"https://www.hepdata.net/download/table/ins1672944/Table 45/yaml","yoda":"https://www.hepdata.net/download/table/ins1672944/Table 45/yoda","yoda.h5":"https://www.hepdata.net/download/table/ins1672944/Table 45/yoda.h5","yoda1":"https://www.hepdata.net/download/table/ins1672944/Table 45/yoda1"},"description":"Slope of a linear fit to R_{+1} for 0.5 &lt; pT &lt; 2 GeV/c versus centrality percentile","doi":"10.17182/hepdata.89396.v1/t45","id":413687,"location":"Figure 7","messages":false,"name":"Table 45","processed_name":"Table45","resources":[]}],"mode":"record","overall_status":"finished","participant_count":3,"recid":89396,"record":{"abstract":"Charged-particle spectra at midrapidity are measured in Pb-Pb collisions at the centre-of-mass energy per nucleon-nucleon pair $\\sqrt{s_{\\rm NN}}$ = 5.02 TeV and presented in centrality classes ranging from most central (0-5%) to most peripheral (95-100%) collisions. Possible medium effects are quantified using the nuclear modification factor ($R_{\\rm AA}$) by comparing the measured spectra with those from proton-proton collisions, scaled by the number of independent nucleon-nucleon collisions obtained from a Glauber model. At large transverse momenta ($8<p_{\\rm T}<20$ GeV/$c$), the average $R_{\\rm AA}$ is found to increase from about $0.15$ in 0-5% central to a maximum value of about $0.8$ in 75-85% peripheral collisions, beyond which it falls off strongly to below $0.2$ for the most peripheral collisions. Furthermore, $R_{\\rm AA}$ initially exhibits a positive slope as a function of $p_{\\rm T}$ in the $8$-$20$ GeV/$c$ interval, while for collisions beyond the 80% class the slope is negative. To reduce uncertainties related to event selection and normalization, we also provide the ratio of $R_{\\rm AA}$ in adjacent centrality intervals. Our results in peripheral collisions are consistent with a PYTHIA-based model without nuclear modification, demonstrating that biases caused by the event selection and collision geometry can lead to the apparent suppression in peripheral collisions. This explains the unintuitive observation that $R_{\\rm AA}$ is below unity in peripheral Pb-Pb, but equal to unity in minimum-bias p-Pb collisions despite similar charged-particle multiplicities.","access_urls":{"links":{"csv":"https://www.hepdata.net/download/submission/ins1672944/1/csv","json":"https://www.hepdata.net/download/submission/ins1672944/1/json","root":"https://www.hepdata.net/download/submission/ins1672944/1/root","yaml":"https://www.hepdata.net/download/submission/ins1672944/1/yaml","yoda":"https://www.hepdata.net/download/submission/ins1672944/1/yoda"}},"analyses":[],"arxiv_id":"arXiv:1805.05212","collaborations":["ALICE"],"control_number":"89396","creation_date":"2018-05-14","data_abstract":"Charged-particle spectra at midrapidity are measured in Pb--Pb collisions at the centre-of-mass energy per nucleon--nucleon pair $\\snn = 5.02$ TeV and presented in centrality classes ranging from most central~(0--5\\%) to most peripheral~(95--100\\%) collisions. Possible medium effects are quantified using the nuclear modification factor~($\\RAA$) by comparing the measured spectra with those from proton--proton collisions, scaled by the number of independent nucleon--nucleon collisions obtained from a Glauber model.","data_keywords":{"cmenergies":[{"gte":5020.0,"lte":5020.0}],"phrases":["RAA"],"reactions":["PB PB --> charged X"]},"doc_type":"publication","doi":"10.1016/j.physletb.2019.04.047","first_author":{"affiliation":"Calcutta, VECC","full_name":"Acharya, Shreyasi"},"hepdata_doi":"10.17182/hepdata.89396.v1","id":89396,"inspire_id":"1672944","journal_info":"Phys.Lett.B 793 (2019) 420-432","keywords":[{"schema":"INSPIRE","value":"heavy ion: scattering"},{"schema":"INSPIRE","value":"charged particle: spectrum"},{"schema":"INSPIRE","value":"charged particle: multiplicity"},{"schema":"INSPIRE","value":"model: Glauber"},{"schema":"INSPIRE","value":"p p: scattering"},{"schema":"INSPIRE","value":"matter: effect"},{"schema":"INSPIRE","value":"peripheral"},{"schema":"INSPIRE","value":"nucleus"},{"schema":"INSPIRE","value":"slope"},{"schema":"INSPIRE","value":"transverse momentum"},{"schema":"INSPIRE","value":"suppression"},{"schema":"INSPIRE","value":"experimental results"},{"schema":"INSPIRE","value":"5020 GeV-cms/nucleon"}],"last_updated":"Wed, 05 Feb 2020 09:46:16 GMT","parent_ch