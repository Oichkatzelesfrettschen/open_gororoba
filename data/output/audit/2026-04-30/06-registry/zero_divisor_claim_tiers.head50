# Zero-divisor claim tier classification.
#
# Three tiers per the peer-review audit (2026-03-20):
#   literature_backed -- proved in published papers (Moreno, Reggiani, Wilmot, Zhilina)
#   computationally_verified -- proved numerically in this project's test suite
#   conjectural -- plausible but unproven; needs formal proof or counterexample
#
# This file does NOT duplicate claim statements. It references claims by ID
# and adds only the tier classification and a one-line rationale.

[zero_divisor_claim_tiers]
authoritative = true
updated = "2026-03-20"

# ── Literature-backed ────────────────────────────────────────────────────────
# These results are proved in peer-reviewed or arXiv papers.

[[tier]]
tier = "literature_backed"
description = "Z(S) = G2 (14-dimensional Lie group)"
source = "Reggiani 2024, arXiv:2411.18881, Theorem 3.1"
project_test = "reggiani::tests::test_reggiani_zd_manifold_dimension_is_g2"
notes = "Numerically verified: Jacobian rank=18, manifold dim=32-18=14=dim(G2)."

[[tier]]
tier = "literature_backed"
description = "ZD(S) = V_2(R^7) (11-dimensional Stiefel manifold)"
source = "Reggiani 2024, arXiv:2411.18881; Moreno 2005, math/0512517 (ancestry)"
project_test = "reggiani::tests::test_reggiani_single_zd_stiefel_v2r7"
notes = "Verified via fiber counting: dim(Z(S))-dim(S^3 fiber)=14-3=11. Moreno gives the V_{2^{n-1},2} generalization; Reggiani gives the precise V_2(R^7) with metric."

[[tier]]
tier = "literature_backed"
description = "Zero divisors occur in multiples of 84"
source = "Wilmot 2026, arXiv:2505.11747v3"
project_test = "avt::tests::test_wilmot_multiples_of_84_sedenion"
notes = "find_zero_divisors(16) returns 168 = 84*2. Wilmot proves ZDs reduce to 7 primary pairs. CAUTION: Wilmot preprint is still moving (v2 correction, v3 new split-sedenion analysis)."

[[tier]]
tier = "literature_backed"
description = "7 box-kites partition all 42 assessors"
source = "de Marrais 2000, arXiv:math/0011260; Wilmot 2026"
project_test = "boxkites::tests::test_assessors_partition_into_boxkites"
notes = "7 connected components of the co-assessor graph. zero_divisor_primary_seven() extracts one pair per box-kite."

[[tier]]
tier = "literature_backed"
description = "All CD imaginary basis units anti-commute"
source = "Standard CD construction theory"
project_test = "zd_graphs::tests::test_zhilina_commutativity_graph_sedenion"
