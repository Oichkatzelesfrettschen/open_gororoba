# Project canonical CSV dataset registry.
# Each [[dataset]] entry declares a project-generated canonical CSV that serves as
# a reproducible artifact consumed by downstream experiments or claims verification.
# ID format: PC-XXXX. Managed by the governance gate (crossrefs check).

[project_csv_canonical_datasets]
updated = "2026-03-20"
authoritative = true
status = "active"
status_token = "ACTIVE"
dataset_count = 42

