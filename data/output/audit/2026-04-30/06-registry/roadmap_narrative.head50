# Roadmap narrative overlay for the DB-backed compatibility export.
# WHY: Provides prose context that annotates the structured registry/roadmap.toml export.
#      Describes architectural direction and policy, not test counts.
# HOW: Edit body_markdown; run `make registry-build registry-export-markdown` to regenerate mirrors.

[roadmap_narrative]
body_markdown = """
See registry/roadmap.toml for the authoritative workstream definitions.
This narrative overlay provides qualitative direction for each sprint and workstream.
"""
