:"https://orcid.org/0000-0002-1808-2767"}],"contributorType":"ContactPerson","affiliation":[]}],"dates":[{"date":"2026-01-23","dateType":"Available"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"Dataset","resourceTypeGeneral":"Dataset","citeproc":"dataset","bibtex":"misc","ris":"DATA","resourceType":"Dataset"},"relatedIdentifiers":[{"relationType":"IsSupplementTo","relatedIdentifier":"10.48550/arxiv.2601.03210","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Data related to a publication, \"Emulating 2D Materials with magnons\" to be published, but also as a preprint on arXiv https://arxiv.org/abs/2601.03210.\r\nIt contains scripts for the simulation program Mumax3, and python scripts for conversion and analysis."}],"geoLocations":[],"fundingReferences":[{"funderName":"NSF MRSEC ","awardNumber":"DMR-2309037"},{"funderIdentifierType":"Crossref Funder ID","funderName":"U.S. Department of Energy (DOE)","funderIdentifier":"https://doi.org/10.13039/100000015","awardNumber":"DE-SC0022060"}],"url":"https://databank.illinois.edu/datasets/IDB-8460963","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":2,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-01-23T16:47:18Z","registered":"2026-01-23T16:47:20Z","published":null,"updated":"2026-01-23T19:13:14Z"},"relationships":{"client":{"data":{"id":"illinois.databank","type":"clients"}}}}],"meta":{"total":2,"totalPages":1,"page":1},"links":{"self":"https://ap