# Git LFS tracking rules
# PDFs stored via LFS to avoid bloating git history
papers/pdf/*.pdf filter=lfs diff=lfs merge=lfs -text
data/external/documents_ingest/**/*.pdf filter=lfs diff=lfs merge=lfs -text
data/external/documents_extracted/**/*.png filter=lfs diff=lfs merge=lfs -text
data/output/heliosphere/soho/celias_pm_native_5min.csv filter=lfs diff=lfs merge=lfs -text
# Canonical SQLite registry files are source artifacts; keep them as Git blobs.
registry/canonical/*.sqlite3 -filter -diff -merge -text
*.csv filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.nsys-rep filter=lfs diff=lfs merge=lfs -text
*.sqlite filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
*.cdf filter=lfs diff=lfs merge=lfs -text
data/output/audit/staples-causal-validation/source-archives/external-intake.tar.zst filter=lfs diff=lfs merge=lfs -text
data/output/audit/staples-causal-validation/source-archives/calibration-research.tar.zst filter=lfs diff=lfs merge=lfs -text
data/output/audit/artifact-retrieval-correspondence/headers-*.txt -text whitespace=-blank-at-eof,-blank-at-eol,cr-at-eol
data/output/audit/provenance-experiment-module-ownership/replay-comparison-*.json filter=lfs diff=lfs merge=lfs -text
data/output/audit/staples-causal-validation/results/bootstrap.json filter=lfs diff=lfs merge=lfs -text
# Preserve the vendored release archive's original text bytes and licenses.
vendor/proc-macro-error2/** -text
vendor/proc-macro-error2/LICENSE-APACHE whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Unified-diff context markers are retained evidence bytes on empty lines.
data/output/audit/staples-orbit-worktree-reconciliation/e8-uncommitted-before.patch whitespace=-blank-at-eol -text
# Retained replay payloads stay materialized for numerical audits through LFS.
data/output/audit/provenance-experiment-module-ownership/historical-replay/*.json filter=lfs diff=lfs merge=lfs -text
